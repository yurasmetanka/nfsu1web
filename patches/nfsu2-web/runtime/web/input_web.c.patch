+        last->x = s.x; last->y = s.y; last->dx += s.dx; last->dy += s.dy;
+    } else {
+        if (g_ms_n == MOUSE_STEPS) step_take();
+        g_ms[(g_ms_head + g_ms_n) % MOUSE_STEPS] = s; g_ms_n++;
+    }
+    pthread_mutex_unlock(&g_ms_mx);
+}
+static void mouse_take(void){
+    long f = metal_frames();
