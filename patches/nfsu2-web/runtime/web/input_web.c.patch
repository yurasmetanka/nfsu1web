+static void step_take(void){
+    const MouseStep *s = &g_ms[g_ms_head];
+    if (s->kind != MS_BTN){ g_view_x = s->x; g_view_y = s->y; g_view_dx += s->dx; g_view_dy += s->dy; }
+    else g_view_btn = s->btn;
