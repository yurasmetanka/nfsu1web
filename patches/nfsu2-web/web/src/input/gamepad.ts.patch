 export interface PadSnapshot { connected: boolean; buttons: number; axes: number[]; family: number; name: string; index: number }
+/** the touch controls' virtual controller (merged with a real one if any) */
+export interface TouchPad { buttons: number; lx: number }
+
+export function withTouch(s: PadSnapshot, t: TouchPad | null): PadSnapshot {
+  if (!t) return s;
+  const axes = [...s.axes];
+  if (Math.abs(t.lx) > Math.abs(axes[PAD_AXIS_LX])) axes[PAD_AXIS_LX] = Math.max(-1, Math.min(1, t.lx));
+  return {
+    connected: true, buttons: s.buttons | t.buttons, axes,
+    family: s.connected ? s.family : PADF_XBOX, name: s.connected ? s.name : 'Touch controls', index: s.index,
+  };
+}
 
 // standard mapping: buttons[i] -> PAD_* (6 and 7 are the analog triggers)
